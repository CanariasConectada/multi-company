<odoo>
    <!-- A leaf category under a parent shipped by res_company_category demo -->
    <record id="category_shop_wholesale" model="res.company.category">
        <field name="parent_id" ref="res_company_category.category_shop" />
        <field name="name">Wholesale Shops</field>
    </record>

    <!-- A demo user allowed to manage company categories from contacts -->
    <record
        id="demo_user_company_category_manager"
        model="res.users"
        context="{'no_reset_password': True}"
    >
        <field name="login">company_category_manager_demo</field>
        <field name="name">Company Category Manager (demo)</field>
        <field
            name="group_ids"
            eval="[
                (4, ref('res_company_category_partner.group_company_category_manager')),
                (4, ref('base.group_partner_manager')),
            ]"
        />
    </record>
</odoo>
