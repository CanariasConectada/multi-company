<odoo>
    <record id="res_groups_privilege_company_categories" model="res.groups.privilege">
        <field name="name">Company Categories</field>
        <field name="category_id" ref="base.module_category_extra" />
    </record>

    <record id="group_company_category_manager" model="res.groups">
        <field name="name">Company Category Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_company_categories" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field
            name="comment"
        >Members can assign the category of a company from its main contact form and create new leaf categories under an existing parent. Only administrators can create root categories.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_company_category_manager'))]" />
    </record>
</odoo>
